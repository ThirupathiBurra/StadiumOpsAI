# ─── Firebase Client SDK (public — safe to expose) ────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Google AI Studio ─────────────────────────────────────────────────────────
# Used by Firebase Cloud Functions only (server-side). Never expose to client.
GEMINI_API_KEY=

# ─── Firebase Admin (Functions runtime — auto-injected in Cloud Functions) ────
# Only needed for local emulator development
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
# Options: development | staging | production
