rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Safe role getter — returns empty string if user doc or role field doesn't exist
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('role', '');
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isOperationsOrAbove() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'operations_manager'];
    }

    function canCreateIncident() {
      return isAuthenticated() && getUserRole() in [
        'super_admin',
        'operations_manager',
        'security_officer',
        'medical_staff',
        'zone_marshal'
      ];
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ─── Users Collection ────────────────────────────────────────────────────
    // Users can read their own profile.
    // Any authenticated user can create their own profile (first sign-in).

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOperationsOrAbove());
      // Allow any authenticated user to create their own profile document on first sign-in
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && onlyUpdatingAllowedFields(['lastLoginAt', 'photoURL', 'displayName']));
      allow delete: if isAdmin();

      function onlyUpdatingAllowedFields(allowedFields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
      }
    }

    // ─── Zones Collection ────────────────────────────────────────────────────
    // All authenticated users can read zones (needed for dashboard).
    // Agents write via Admin SDK (bypasses rules). Admins can write directly.

    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Incidents Collection ─────────────────────────────────────────────────
    // Any authenticated user can create/update incidents (demo mode).
    // In production, use role-based canCreateIncident().

    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ─── Alerts Collection ────────────────────────────────────────────────────
    // All authenticated users read. Agents write via Admin SDK.

    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && onlyUpdatingAlertStatus();
      allow delete: if isAdmin();

      function onlyUpdatingAlertStatus() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt']);
      }
    }

    // ─── Audit Logs — APPEND ONLY ─────────────────────────────────────────────
    // Nobody can update or delete audit logs. Agents write via Admin SDK.
    // All authenticated users can read (demo mode; restrict to ops in production).

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;     // NEVER allow updates
      allow delete: if false;     // NEVER allow deletes
    }

    // ─── Simulations Collection ───────────────────────────────────────────────

    match /simulations/{simulationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ─── Agent State Collection ───────────────────────────────────────────────
    // Read-only for authenticated users. Admin SDK writes.

    match /agentState/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

  }
}
